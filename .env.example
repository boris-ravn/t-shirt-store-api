NODE_ENV=development
PORT=3000

# Local Postgres, see docker-compose.yml
DATABASE_URL="postgresql://tshirt_store:tshirt_store@localhost:5432/tshirt_store?schema=public"

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Local dev mail catcher, see docker-compose.yml (Mailhog UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="T-Shirt Store <no-reply@tshirt-store.example>"

AWS_REGION=us-east-1
AWS_S3_BUCKET=tshirt-store-dev
AWS_ACCESS_KEY_ID=tshirt_store
AWS_SECRET_ACCESS_KEY=tshirt_store_minio
# Local MinIO (see docker-compose.yml, console at http://localhost:9001) —
# leave this unset entirely to talk to real AWS S3 instead.
AWS_S3_ENDPOINT=http://localhost:9000

# Global rate limit (requests per TTL window, seconds); auth endpoints override this with tighter limits
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# Stripe, test mode only — from the Dashboard's Developers > API keys page.
# STRIPE_WEBHOOK_SECRET is the signing secret for whichever endpoint
# forwards events to this app (`stripe listen --print-secret` locally).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# A pending order older than this is treated as abandoned and auto-cancelled
STALE_ORDER_MAX_AGE_MINUTES=30

# Redis, for the stock-notification queue (BullMQ), see docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6379
