// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Modeled incrementally (decisions.md, 2026-08-28): only the tables the
// current slice needs. The rest of docs/database/erd.dbml (promos, orders,
// payments, notifications) is added as those features land.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  manager
  client
  delivery_person

  @@map("user_role")
}

enum ProductStatus {
  active
  disabled

  @@map("product_status")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  role              UserRole  @default(client)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  cart                Cart?
  likes               Like[]
  createdPromoCodes   PromoCode[]
  orders              Order[]
  orderStatusChanges  OrderStatusHistory[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String
  description String?
  status      ProductStatus @default(active)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  skus       Sku[]
  likes      Like[]
  orderItems OrderItem[]

  @@index([categoryId, createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  s3Key     String   @map("s3_key")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
  @@map("product_images")
}

// sku_code and (productId, size, color) are declared as plain @unique here,
// matching erd.dbml — both must become partial (`WHERE deleted_at IS NULL`)
// by hand in the generated migration; see docs/database/README.md §9.
model Sku {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  skuCode       String    @unique @map("sku_code")
  size          String
  color         String
  price         Int
  stock         Int       @default(0)
  reservedStock Int       @default(0) @map("reserved_stock")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product    Product     @relation(fields: [productId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("skus")
}

// ---------------------------------------------------------------- cart

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

// No price snapshot, unlike order_items — the price always reflects the
// SKU's current value.
model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  cart Cart @relation(fields: [cartId], references: [id])
  sku  Sku  @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
  @@map("cart_items")
}

// product_id, not sku_id — a like applies to the product, not one variant.
model Like {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@map("likes")
}

// ---------------------------------------------------------------- promotions

enum DiscountType {
  percentage
  fixed_amount

  @@map("discount_type")
}

// discount_value is a percentage (1-100) or minor units depending on
// discount_type; range validated in the service layer, not a schema CHECK.
model PromoCode {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String       @unique
  discountType      DiscountType @map("discount_type")
  discountValue     Int          @map("discount_value")
  minPurchaseAmount Int?         @map("min_purchase_amount")
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz
  usageLimit        Int          @map("usage_limit")
  timesRedeemed     Int          @default(0) @map("times_redeemed")
  isActive          Boolean      @default(true) @map("is_active")
  createdBy         String       @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator User    @relation(fields: [createdBy], references: [id])
  orders  Order[]

  @@map("promo_codes")
}

// ---------------------------------------------------------------- orders

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled

  @@map("order_status")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(pending)
  subtotal       Int
  promoCodeId    String?     @map("promo_code_id") @db.Uuid
  discountAmount Int         @default(0) @map("discount_amount")
  total          Int
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User                  @relation(fields: [userId], references: [id])
  promoCode       PromoCode?            @relation(fields: [promoCodeId], references: [id])
  items           OrderItem[]
  shippingDetails OrderShippingDetails?
  statusHistory   OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([promoCodeId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  skuId       String   @map("sku_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int
  unitPrice   Int      @map("unit_price")
  productName String   @map("product_name")
  size        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  order   Order   @relation(fields: [orderId], references: [id])
  sku     Sku     @relation(fields: [skuId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([skuId])
  @@index([productId])
  @@map("order_items")
}

model OrderShippingDetails {
  orderId       String   @id @map("order_id") @db.Uuid
  recipientName String   @map("recipient_name")
  phone         String?
  line1         String
  line2         String?
  city          String
  state         String?
  postalCode    String   @map("postal_code")
  country       String   @db.Char(2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_shipping_details")
}

// clock_timestamp(), not now() — see docs/database/README.md §5.
model OrderStatusHistory {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  changedBy String?     @map("changed_by") @db.Uuid
  createdAt DateTime    @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz

  order         Order @relation(fields: [orderId], references: [id])
  changedByUser User? @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
  @@index([changedBy, status, createdAt])
  @@map("order_status_history")
}
